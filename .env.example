# Generate .env with fresh keys using: npm run setup
API_KEY=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# Optional: separate random key enabling GET /send-otp?key=...&phone=...&otp=...
URL_SEND_KEY=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
OTP_MESSAGE_TEMPLATE="Your verification code is {otp}. Do not share this code."
SEND_TIMEOUT_MS=20000
RATE_LIMIT_MAX=30
LOG_LEVEL=info
# Only needed when using compose.https.yaml. DNS must point to the Oracle VM.
API_DOMAIN=otp.example.com
