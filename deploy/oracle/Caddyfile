{
    admin off
    auto_https disable_redirects
    servers {
        protocols h1 h2
    }
}

https://otp.sirfbazar.com {
    # Port 80 belongs to an existing application. Only use the TLS challenge on 443.
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            disable_http_challenge
        }
    }
    @public path /send-otp /health /ready
    handle @public {
        reverse_proxy 127.0.0.1:3300
    }
    handle {
        respond "Not found" 404
    }
}
