{
    admin off
    auto_https off
    servers {
        protocols h1 h2
    }
}

:80 {
    @otp host otp.sirfbazar.com
    handle @otp {
        @public path /send-otp /send-message /health /ready /pair /pair/app.js /admin/session /admin/qr /admin/pairing-code /admin/reset
        handle @public {
            reverse_proxy 127.0.0.1:3300
        }
        handle {
            respond "Not found" 404
        }
    }
    # Preserve the existing website for its domains and direct-IP requests.
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}
